# Copy to `.env` and fill in. serve.py loads this automatically (never commit .env).
#
# Internal integration token from https://www.notion.so/my-integrations (starts with ntn_)
NOTION_TOKEN=
# The database id from your "Evee Inventory" database URL.
# (the 32-char id in notion.so/<workspace>/<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=
# Optional: skip the database->data_source lookup by pinning the data source id.
# NOTION_DATA_SOURCE_ID=

# ── AI assistant (/api/chat, Phase 2) ──────────────────────────────────────
# Anthropic API key from https://console.anthropic.com/settings/keys
# (needs `pip install -r requirements.txt`). Omit to keep the chat disabled.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-4-5).
# ANTHROPIC_MODEL=claude-haiku-4-5

# ── Evee's voice, both directions (/api/tts + /api/stt) ────────────────────
# ElevenLabs gives Evee a natural voice AND transcribes what you say. Omit the
# key and she stays silent and can't listen — the text chat still works.
# API key from the ElevenLabs dashboard → API Keys (starts with sk_).
# IMPORTANT: the key needs BOTH "Text to Speech" and "Speech to Text"
# permissions. Keys are scoped per capability; a TTS-only key fails /api/stt
# with "missing the permission speech_to_text".
ELEVENLABS_API_KEY=
# The voice's id — open a voice in the app and use "Copy Voice ID".
ELEVENLABS_VOICE_ID=
# Optional: model. Default eleven_flash_v2_5 (lowest latency). Alternatives:
# eleven_turbo_v2_5 (balanced) or eleven_multilingual_v2 (highest quality).
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional: speech-to-text model. Default scribe_v1.
# ELEVENLABS_STT_MODEL=scribe_v1
# Optional: pin the spoken language (default eng). Without it Scribe
# auto-detects per clip, and a short or quiet recording is enough for it to
# guess wrong and return confident gibberish. Set to "" to re-enable detection.
# ELEVENLABS_STT_LANG=eng
